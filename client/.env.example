# Copy this file to .env.local and fill in real values from Firebase console.
# Project settings -> Your apps -> Web app config.
# Only Firebase client-side web configuration belongs here. Do not put service
# account JSON, private keys, or any server credentials in these variables.

VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
